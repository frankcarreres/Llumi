{
  "compilerOptions": {
    "baseUrl": "src",
    "paths": {
      "@/*":          ["*"],
      "src/*" :        ["src/*"],
      "admin/*":      ["admin/*"],
      "assets/*":     ["assets/*"],
      "components/*": ["components/*"],
      "examples/*":   ["examples/*"],
      "layouts/*":    ["layouts/*"],
